#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Pipeline configuration -- EXAMPLE
#
# Copy to config/pipeline.env and edit. config/pipeline.env is gitignored so
# that real cluster paths, subject lists and scan data never enter the repo.
#
#   cp config/pipeline.env.example config/pipeline.env
#
# Every path below is a placeholder. Nothing here points at a real dataset.
# ---------------------------------------------------------------------------

# ---- Scheduler -------------------------------------------------------------
# Partition/queue name for your cluster. Run `sinfo -s` to list valid names.
SLURM_PARTITION="normal"

# Per-stage resource requests. Tuned for ~1000 subjects on a Lustre-backed
# cluster; adjust for your node sizes and I/O.
DCM2NII_TIME="00:30:00"
DCM2NII_MEM="10G"
DCM2NII_CPUS=1

FMRIPREP_TIME="06:00:00"
FMRIPREP_MEM="20G"
FMRIPREP_CPUS=4

TS_TIME="03:00:00"
TS_MEM="32G"
TS_CPUS=8
TS_NJOBS=6          # joblib workers inside one task; keep < TS_CPUS

# ---- Stage 1: data preparation --------------------------------------------
# Root of the raw DICOM tree, laid out as:
#   $DICOM_DIR/<pID>/<pID>_<YYYYMMDD>/scans/<scan>/resources/DICOM/files/*.dcm
DICOM_DIR="/path/to/raw/dicom"

# Raw behavioral logs (E-Prime .txt exports), wide and long format.
EPRIME_DIR_WIDE="/path/to/raw/behav/eprime_primary"
EPRIME_DIR_LONG="/path/to/raw/behav/eprime_secondary"

# E-Prime export filename patterns. Tokens {subj} {run} {dir} are substituted;
# `*` globs. The literal parts depend on how your scanner console named its
# exports, so these are deliberately loose.
EPRIME_PATTERN_WIDE="*{subj}*_run{run}_{dir}_TAB.txt"
EPRIME_PATTERN_LONG="*{subj}*_run{run}_{dir}.txt"
EPRIME_PATTERN_NESTED="{subj}/visit*/session*/fmri/run*/behav/*{subj}*_run{run}_{dir}_TAB.txt"

# Generated manifests. Keep these OUTSIDE the repo: they contain subject IDs
# and scan dates.
WORK_DIR="/path/to/scratch/pipeline_work"
SUBJECT_LIST="${WORK_DIR}/subjlist.txt"          # header: pID
SESSION_MAP="${WORK_DIR}/session_map.txt"        # header: pID,session_date,session_num
TS_SUBJECT_LIST="${WORK_DIR}/ts_subjlist.txt"    # header: pID session_num

# ---- Stage 2: BIDS conversion ---------------------------------------------
NIFTI_DIR="${WORK_DIR}/nifti"        # dcm2niix output, pre-BIDS
BEHAV_DIR="${WORK_DIR}/behav"        # MATLAB task-design output (.mat/.tsv)
BIDS_DIR="${WORK_DIR}/bids"          # BIDS dataset root
BIDS_MAPPING_JSON="BIDS_conversion/nii2bids/bids_mapping.json"

# ---- Stage 3: fMRIPrep -----------------------------------------------------
FMRIPREP_DIR="${WORK_DIR}/fmriprep"  # derivatives/, work/ and logs/ live here
FMRIPREP_SIMG="/path/to/fmriprep-24.1.1.simg"

# FreeSurfer license. NEVER commit this file or place it inside the repo.
# Obtain your own at https://surfer.nmr.mgh.harvard.edu/registration.html
FS_LICENSE_FILE="/path/to/private/freesurfer_license.txt"

# ---- Stage 4: timeseries extraction ---------------------------------------
TS_DIR="${WORK_DIR}/timeseries"      # .npz output
ROI_DIR="/path/to/roi_masks"
ROI_EXPRESSION="*_Atlas.nii.gz"      # glob, one mask file per ROI

TASK_LABEL="WM"                      # BIDS task-<label>
TR="0.8"                             # seconds
HIGH_PASS="0.008"                    # Hz
DUMMY_SCANS="4"                      # volumes discarded at run onset
